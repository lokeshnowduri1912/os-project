# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary

# Shell scripts
*.sh text eol=lf

# Text files
*.txt text eol=lf
*.md text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pyc binary
